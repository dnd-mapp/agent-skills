{
  "name": "agent-skills",
  "version": "1.3.0",
  "description": "Claude Code Agent Skills and Subagent definitions for the dnd-mapp organization",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "lint-md": "markdownlint-cli2",
    "format": "prettier -w .",
    "format-check": "prettier -l ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "~21.2.1",
    "@commitlint/config-conventional": "~21.2.0",
    "husky": "~9.1.7",
    "lint-staged": "~17.3.0",
    "markdownlint-cli2": "~0.23.2",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0"
  }
}
